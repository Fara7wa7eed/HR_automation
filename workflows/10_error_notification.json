    {
      "name": "Sanitize failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const e=$json;if(!String(e.workflow?.name||'').startsWith('BrightPath |'))return [];if(!e.config.hrEmail||e.config.hrEmail.includes('CONFIGURE_'))throw Error('Configure HR notification mailbox');return [{json:{to:e.config.hrEmail,subject:'BrightPath automation needs attention',message:'Workflow: '+e.workflow.name+'\\nExecution reference: '+String(e.execution?.id||'unavailable')+'\\nCheck the n8n execution status and the Automation Queue. No applicant details are included in this alert.'}}];"
      },
      "id": "9af53434-4c86-4e21-8804-51e51d1c3cef",
      "position": [
        520,
        0
      ]
    },
    {
      "name": "Notify HR operator",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.message }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "cNwkVHIKnkzKW0O8",
